	</variable>
	<variable name="billAmount" class="java.lang.Double">
		<variableExpression><![CDATA[$F{grand_total}.doubleValue()+$F{total_discount}.doubleValue()+$F{total_adjust}.doubleValue()-$F{total_shipping}.doubleValue()]]></variableExpression>
	</variable>
	<variable name="totalCollection" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total_received}]]></variableExpression>
	</variable>
	<variable name="totalBillAmount" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
	</variable>
	<variable name="rowNo" class="java.lang.Integer" calculation="Count">
